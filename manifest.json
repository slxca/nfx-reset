{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "NFX Reset",
  "description": "__MSG_appDesc__",
  "default_locale": "en",
  "version": "1.2.0",
  "homepage_url": "https://github.com/slxca/nfx-reset",
  "permissions": [
    "cookies"
  ],
  "host_permissions": [
    "https://www.netflix.com/*",
    "https://web.prod.cloud.netflix.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}